RewriteEngine On
RewriteCond %{SERVER_PORT} !^443$
RewriteRule .* https://%{SERVER_NAME}%{REQUEST_URI} [R,L]

# Служебные папки — части страниц, настройки и скрипты для командной строки. Открытые по прямой ссылке,
# они показывали бы ошибки PHP с путями на сервере. Для посетителя их нет.
RewriteRule ^(inc|data|tools)(/|$) - [R=404,L]

# Несуществующая страница — своя, с шапкой и подвалом сайта
ErrorDocument 404 /404.php



# Сжатие текстовых файлов при передаче
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/webp .webp
    AddType image/avif .avif
</IfModule>

# Кэш в браузере. Стили и скрипты подключаются с меткой версии (?v=...), поэтому после правки обновляются сразу.
# Картинку, заменённую под тем же именем, браузер посетителя может показывать старой до месяца — новым картинкам давайте новые имена.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 month"
</IfModule>
